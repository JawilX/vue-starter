{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --open",
    "build": "vite build",
    "test": "vite build --mode development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "up": "taze -I",
    "postinstall": "npx simple-git-hooks",
    "genapi:init": "gen-api init",
    "genapi": "gen-api now"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.58.0",
    "@vueuse/core": "^15.0.0",
    "dayjs": "^1.11.23",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@antfu/utils": "^9.3.0",
    "@arco-plugins/vite-vue": "^1.4.6",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@iconify-json/carbon": "^1.2.27",
    "@jawilx/gen-api": "^2.8.0",
    "@types/node": "^22.20.4",
    "@unocss/eslint-config": "^66.10.5",
    "@unocss/eslint-plugin": "^66.10.5",
    "@unocss/reset": "^66.10.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.39.4",
    "eslint-plugin-format": "^1.5.0",
    "less": "^4.9.1",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.14.0",
    "taze": "^21.1.0",
    "typescript": "^5.9.3",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-router": "^0.15.0",
    "vite": "^6.4.3",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit \"${1}\""
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
